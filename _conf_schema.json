{
  "general": {
    "type": "object",
    "description": "基础设置",
    "hint": "开关、权限、数据上限；不会修改其他插件。",
    "items": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "启用语义表情包插件"
      },
      "admin_users": {
        "type": "list",
        "default": [],
        "description": "额外管理员 ID 列表",
        "hint": "除 AstrBot 全局管理员外，允许执行导入/删除/改标签的用户。"
      },
      "target_scopes": {
        "type": "list",
        "default": [],
        "description": "生效会话白名单",
        "hint": "填群号或 private_用户ID；留空表示全部会话。"
      },
      "max_stickers": {
        "type": "int",
        "default": 500,
        "min": 1,
        "max": 5000,
        "description": "表情包数量上限"
      },
      "import_dir": {
        "type": "string",
        "default": "",
        "description": "默认导入目录",
        "hint": "/sk import 不填路径时使用；留空则使用插件数据目录下的 imports。"
      },
      "import_recursive": {
        "type": "bool",
        "default": false,
        "description": "导入时递归扫描子目录"
      }
    }
  },
  "learning": {
    "type": "object",
    "description": "学习与分类",
    "hint": "从消息学习表情包，并用视觉模型离线分类。",
    "items": {
      "auto_learn": {
        "type": "bool",
        "default": true,
        "description": "自动从聊天中学习表情包"
      },
      "learn_target_users": {
        "type": "list",
        "default": [],
        "description": "只学习这些用户的表情包",
        "hint": "留空表示所有用户；建议只填表情包多的群友。"
      },
      "learn_all_images": {
        "type": "bool",
        "default": false,
        "description": "把所有图片都当表情包学习",
        "hint": "默认只学习 NapCat 标记为动画表情/表情的图片，避免相册照片入库。"
      },
      "auto_classify": {
        "type": "bool",
        "default": true,
        "description": "新表情包自动调用视觉模型分类"
      },
      "safety_filter_enabled": {
        "type": "bool",
        "default": true,
        "description": "启用不适宜内容过滤",
        "hint": "关闭后分类不会把 safe=false 的表情自动禁用；已经禁用的需要手动恢复。"
      },
      "classify_provider_id": {
        "type": "string",
        "default": "",
        "description": "分类用的视觉 Provider ID",
        "hint": "留空则使用 AstrBot 的图片理解 Provider，再回退到当前对话模型。"
      },
      "retag_provider_id": {
        "type": "string",
        "default": "",
        "description": "按描述重算标签用的文字 Provider ID",
        "hint": "留空使用当前对话模型；不需要图片能力。"
      },
      "classify_concurrency": {
        "type": "int",
        "default": 2,
        "min": 1,
        "max": 8,
        "description": "批量分类并发数"
      },
      "classify_timeout": {
        "type": "int",
        "default": 60,
        "min": 10,
        "max": 300,
        "description": "单张分类超时（秒）"
      },
      "max_file_mb": {
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 50,
        "description": "单个表情包文件大小上限（MB）"
      }
    }
  },
  "selection": {
    "type": "object",
    "description": "发送策略",
    "hint": "轻回复只发表情包，普通回复按概率附加。",
    "items": {
      "light_reply_enabled": {
        "type": "bool",
        "default": true,
        "description": "启用轻回复只发表情包"
      },
      "light_reply_max_chars": {
        "type": "int",
        "default": 12,
        "min": 4,
        "max": 30,
        "description": "轻回复最大字数",
        "hint": "超过这个长度不会整条替换，避免吞掉有效信息。"
      },
      "light_min_score": {
        "type": "float",
        "default": 0.30,
        "min": 0.0,
        "max": 1.0,
        "description": "轻回复表情包匹配门槛"
      },
      "light_trigger_probability": {
        "type": "float",
        "default": 0.9,
        "min": 0.0,
        "max": 1.0,
        "description": "轻回复最终触发概率"
      },
      "append_enabled": {
        "type": "bool",
        "default": true,
        "description": "普通回复允许附加表情包"
      },
      "append_min_text_chars": {
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 100,
        "description": "附加表情包所需的最短回复字数"
      },
      "append_min_score": {
        "type": "float",
        "default": 0.45,
        "min": 0.0,
        "max": 1.0,
        "description": "附加表情包匹配门槛"
      },
      "append_probability": {
        "type": "float",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "description": "满足条件后附加表情包的概率"
      },
      "max_per_hour": {
        "type": "int",
        "default": 10,
        "min": 0,
        "max": 100,
        "description": "每个会话每小时最多发送表情包次数",
        "hint": "0 表示不限制。"
      },
      "sticker_cooldown_seconds": {
        "type": "int",
        "default": 180,
        "min": 0,
        "max": 86400,
        "description": "同一张表情包的最短复用间隔（秒）"
      },
      "recent_history": {
        "type": "int",
        "default": 6,
        "min": 1,
        "max": 20,
        "description": "参与匹配的最近消息条数"
      }
    }
  },
  "prompt": {
    "type": "object",
    "description": "提示词注入",
    "hint": "把当前语境匹配的表情包候选告诉模型。",
    "items": {
      "inject_enabled": {
        "type": "bool",
        "default": true,
        "description": "在 LLM 请求前注入表情包候选"
      },
      "inject_candidates": {
        "type": "int",
        "default": 3,
        "min": 1,
        "max": 5,
        "description": "每次注入的候选数量"
      },
      "inject_max_chars": {
        "type": "int",
        "default": 600,
        "min": 120,
        "max": 2000,
        "description": "注入内容最大字符数"
      },
      "tool_enabled": {
        "type": "bool",
        "default": true,
        "description": "启用 search_stickers / pick_sticker 工具"
      }
    }
  },
  "commands": {
    "type": "object",
    "description": "命令",
    "items": {
      "page_size": {
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 20,
        "description": "/sk list 每页数量"
      }
    }
  }
}
